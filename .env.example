# Copy to `.env` (repo root, used by Docker Compose) and/or `backend/.env` (local `uv run`).
# Never commit real .env files.

# Docker Compose: password for the local PostgreSQL container (choose any value).
POSTGRES_PASSWORD=change-me

# Backend settings (all optional; defaults shown).
SLIP_ENVIRONMENT=development
SLIP_CORS_ORIGINS=["http://localhost:5173"]
SLIP_DATABASE_URL=postgresql+psycopg://slip:change-me@127.0.0.1:5432/slip
SLIP_STORAGE_DIR=../data/storage

# Local generation (Ollama). No hosted LLM fallback exists.
SLIP_OLLAMA_BASE_URL=http://127.0.0.1:11434
SLIP_OLLAMA_MODEL=qwen2.5:3b
SLIP_OLLAMA_TIMEOUT_SECONDS=60
SLIP_OLLAMA_NUM_CTX=4096
SLIP_OLLAMA_MAX_TOKENS=512
SLIP_OLLAMA_TEMPERATURE=0
SLIP_OLLAMA_SEED=0

# Retrieval (FR-24, FR-25; ADR-0008). hybrid_rerank: best recall, ~2 s per search on CPU.
# hybrid: no cross-encoder, ~0.1 s. Also read by docker-compose.yml.
SLIP_SEARCH_MODE=hybrid_rerank
SLIP_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Grounded Q&A. qa_min_score is a cosine-similarity threshold in every search mode (M3 calibration).
SLIP_QA_DEFAULT_TOP_K=6
SLIP_QA_MIN_SCORE=0.30

# Local embeddings
SLIP_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SLIP_EMBEDDING_DIMENSION=384

# Integration tests only: a throwaway database whose name ends in _test (tables are dropped).
SLIP_TEST_DATABASE_URL=postgresql+psycopg://slip:change-me@127.0.0.1:5432/slip_test
